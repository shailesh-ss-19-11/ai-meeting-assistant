# Your provider key and models. Any OpenAI-compatible API works via AI_BASE_URL.
OPENAI_API_KEY=replace-me
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Required, at least 32 characters. Generate with: openssl rand -hex 32
BRIDGE_TOKEN=replace-with-a-random-secret
PORT=8787
